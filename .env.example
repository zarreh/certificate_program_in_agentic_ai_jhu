# Copy this file to `.env` (cp .env.example .env) and fill in your own values.
# `.env` is gitignored: never commit real keys.

OPENAI_API_KEY=your-openai-api-key-here
# Only needed if you use a custom OpenAI-compatible endpoint (e.g. the course proxy).
# For a regular OpenAI key, delete this line.
OPENAI_BASE_URL=https://api.openai.com/v1
